---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Osterferien 2027: Termine aller Bundesländer (Ostern 28. März)";
const description = "Osterferien 2027 in allen 16 Bundesländern laut KMK: meist 22. März bis 2./3. April 2027 (Bayern, Berlin, Hessen, Niedersachsen, NRW, RLP, Thüringen), Baden-Württemberg 30. März–3. April, Saarland 30. März–9. April, Hamburg 1.–12. März. Ostern ist am 28. März 2027.";
const keywords = "Osterferien 2027, Osterferien 2027 NRW, Osterferien 2027 Bayern, Osterferien 2027 Niedersachsen, Osterferien 2027 Hessen, Osterferien 2027 Baden-Württemberg, Frühjahrsferien 2027, Ostern 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Osterferien 2027", url: "/osterferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-emerald-500 to-green-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Osterferien 2027: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Ostern am 28. März 2027 – die meisten Länder sind vom 22. März bis 2./3. April frei</p>
    </div>

    <p class="text-gray-700 mb-6">Weil <strong>Ostern 2027 bereits am 28. März</strong> liegt, fallen die Osterferien 2027 früh: Bayern, Berlin, Brandenburg, Bremen, Hessen, Niedersachsen, Nordrhein-Westfalen, Rheinland-Pfalz und Thüringen sind vom <strong>22. März bis 2. bzw. 3. April 2027</strong> frei. Baden-Württemberg legt seine Ferien um Ostern herum (25. März sowie 30. März–3. April), das Saarland und Schleswig-Holstein starten erst am 30. März, Hamburg hat seine Frühjahrsferien schon vom 1. bis 12. März. Karfreitag (26. März) und Ostermontag (29. März) sind bundesweit Feiertage.</p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Osterferien 2027: Termine aller 16 Bundesländer</h2>
      <p class="text-sm text-gray-600 mb-3">Angegeben ist jeweils der erste und der letzte Ferientag (KMK-Ferienkalender, Stand 09.10.2025). „—" = in diesem Land keine Osterferien.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Osterferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">25.03. sowie 30.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">08.02. – 12.02. (Frühjahr) sowie 22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">01.03. – 12.03.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">24.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">30.03. – 09.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">26.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 27.03.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">30.03. – 10.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Osterferien 2027 mit Urlaub verbinden</h2>
      <p class="text-sm text-gray-700 mb-2">In den Ländern mit Ferien vom 22. März bis 2./3. April genügen <strong>8 Urlaubstage (22.–25. März und 30. März–2. April) für 16 freie Tage</strong> vom 20. März bis 4. April – Karfreitag und Ostermontag sind Feiertage. Wer nur die zweite Ferienwoche nimmt, ist mit 4 Urlaubstagen 9 Tage frei (27. März–4. April).</p>
      <p class="text-sm text-gray-700">Alle Konstellationen: <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a> · Termine: <a href="/ostern-2027" class="text-blue-600 hover:underline">Ostern 2027</a></p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> KMK-Ferienkalender 2026/27 (Stand 09.10.2025), Ferientermine werden von den Kultusministerien der Länder festgelegt; Feiertage nach den Feiertagsgesetzen der Länder.</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag der Osterferien 2027 in allen 16 Bundesländern, angrenzende Feiertage und Brückentage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, Sonderregelungen für Inseln (SH) und kurzfristige Änderungen der Länder.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Osterferien 2027 in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">In Nordrhein-Westfalen vom <strong>22. März bis 3. April 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Osterferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Bayern: <strong>22. März bis 2. April 2027</strong>; zusätzlich Frühjahrsferien vom 8. bis 12. Februar 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Osterferien 2027 in Baden-Württemberg?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Am 25. März sowie vom 30. März bis 3. April 2027 (plus bewegliche Ferientage).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Osterferien 2027 in Niedersachsen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom 22. März bis 3. April 2027 – ebenso Bremen, Brandenburg und Thüringen.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Ostern 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ostersonntag ist am 28. März 2027, Karfreitag am 26. März, Ostermontag am 29. März 2027.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann sind die Osterferien 2027 in NRW?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In Nordrhein-Westfalen vom 22. März bis 3. April 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Osterferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bayern: 22. März bis 2. April 2027; zusätzlich Frühjahrsferien vom 8. bis 12. Februar 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Osterferien 2027 in Baden-Württemberg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Am 25. März sowie vom 30. März bis 3. April 2027 (plus bewegliche Ferientage)."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Osterferien 2027 in Niedersachsen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 22. März bis 3. April 2027 – ebenso Bremen, Brandenburg und Thüringen."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Ostern 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ostersonntag ist am 28. März 2027, Karfreitag am 26. März, Ostermontag am 29. März 2027."
        }
      }
    ]
  })} />
</Layout>
