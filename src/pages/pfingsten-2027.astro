---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Pfingsten 2027: 16. & 17. Mai – Pfingstmontag, Ferien & Brückentage";
const description = "Wann ist Pfingsten 2027? Pfingstsonntag ist am 16. Mai, Pfingstmontag am 17. Mai 2027 (bundesweiter Feiertag). Alle Termine, Pfingstferien je Bundesland und der Brückentage-Plan mit Himmelfahrt und Fronleichnam.";
const keywords = "Pfingsten 2027, wann ist Pfingsten 2027, Pfingstmontag 2027, Pfingstsonntag 2027, Pfingstferien 2027, Pfingsten 2027 Datum, Brückentage Pfingsten 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Pfingsten 2027", url: "/pfingsten-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-sky-600 to-blue-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Pfingsten 2027: Sonntag, 16. Mai und Montag, 17. Mai 2027</h1>
      <p class="text-white/85 text-sm mt-1">Pfingstmontag bundesweit frei · Pfingstferien · Brückentage mit Himmelfahrt und Fronleichnam</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 text-center">
      <p class="text-sm text-gray-500 uppercase tracking-wide">Pfingstsonntag 2027</p>
      <p class="text-4xl sm:text-5xl font-bold text-gray-900 mt-1">Sonntag, 16. Mai 2027</p>
    <p class="text-sm text-gray-600 mt-2" id="countdown" data-datum="2027-05-16">Tage bis 16. Mai 2027</p>
    <script is:inline>
      (function(){var el=document.getElementById('countdown');if(!el)return;var z=new Date(el.dataset.datum+'T00:00:00');var h=new Date();h.setHours(0,0,0,0);var t=Math.round((z-h)/86400000);
      if(t>1)el.textContent='Noch '+t+' Tage bis '+el.textContent.replace(/^.*?bis /,'');else if(t===1)el.textContent='Morgen ist es so weit.';else if(t===0)el.textContent='Heute!';else el.textContent='Der Termin liegt '+(-t)+' Tage zurück.';})();
    </script>
    </div>
    <p class="text-gray-700 mb-6">
      <strong>Pfingsten 2027 ist am Sonntag, 16. Mai, und Montag, 17. Mai 2027.</strong> Der Pfingstmontag ist bundesweit
      gesetzlicher Feiertag. Pfingsten liegt immer 49 Tage nach Ostern (28. März 2027) und bildet mit Christi Himmelfahrt
      (6. Mai) und Fronleichnam (27. Mai) den Feiertags-Block im Mai 2027 – mit nur wenigen Urlaubstagen lassen sich hier
      lange Auszeiten bauen.
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Termine rund um Pfingsten 2027</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Datum</th><th class="py-2 pr-4">Tag</th><th class="py-2 pr-4">Status</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 06.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Christi Himmelfahrt</td><td class="py-2">bundesweiter Feiertag (10 Tage vor Pfingsten)</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 16.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Pfingstsonntag</td><td class="py-2">Feiertag; gesetzlich nur in Brandenburg</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mo 17.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Pfingstmontag</td><td class="py-2">bundesweiter gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 27.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Fronleichnam</td><td class="py-2">Feiertag in BW, BY, HE, NW, RP, SL (10 Tage nach Pfingstmontag)</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Brückentage Pfingsten 2027: 9 Tage frei mit 4 Urlaubstagen</h2>
      <p class="text-sm text-gray-700 mb-3">
        Urlaub von <strong>Dienstag 18. bis Freitag 21. Mai 2027</strong> ergibt zusammen mit Pfingstmontag und zwei
        Wochenenden neun freie Tage (15.–23. Mai). In Baden-Württemberg, Bayern, Hessen, NRW, Rheinland-Pfalz und dem
        Saarland lohnt die Verlängerung bis Fronleichnam: Mit 8 Urlaubstagen (18.–21. Mai, 24.–26. Mai und 28. Mai) sind
        es <strong>16 freie Tage vom 15. bis 30. Mai 2027</strong>. Wer ab Himmelfahrt startet (7. Mai Brückentag plus
        10.–14. Mai), kommt mit 6 Urlaubstagen auf 12 Tage vom 6. bis 17. Mai.
      </p>
      <p class="text-sm text-gray-700">Exakte Konstellationen je Bundesland: <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a>.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Pfingstferien 2027 je Bundesland</h2>
      <p class="text-sm text-gray-600 mb-3">Zweiwöchige Pfingstferien gibt es 2027 nur in Baden-Württemberg (18.–29. Mai) und Bayern (18.–28. Mai); Sachsen-Anhalt macht 15.–22. Mai frei. Viele Länder haben nur einzelne bewegliche Tage rund um Himmelfahrt (7. Mai) und Pfingstdienstag (18. Mai).</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Pfingstferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">18.05. – 29.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">18.05. – 28.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 18.05. – 19.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">07.05. und 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">07.05. – 14.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 14.05. – 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">07.05. und 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 15.05. – 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">15.05. – 22.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">07.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">07.05.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Alle Ferien: <a href="/pfingstferien-2027" class="text-blue-600 hover:underline">Pfingstferien 2027</a> · <a href="/schulferien-2027" class="text-blue-600 hover:underline">Schulferien 2027</a></p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Wie wird das Pfingstdatum bestimmt?</h2>
      <p class="text-sm text-gray-700">Pfingsten ist der 50. Tag der Osterzeit und liegt damit immer 49 Tage nach Ostersonntag – zwischen dem 10. Mai und dem 13. Juni. Weil Ostern 2027 früh liegt (28. März), fällt auch Pfingsten früh auf den 16. Mai. Zum Vergleich: Pfingsten 2026 war am 24. Mai, Pfingsten 2028 ist am 4. Juni.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Pfingsten = Ostersonntag + 49 Tage (Ostern 2027: 28. März), Feiertagsstatus nach den Feiertagsgesetzen der Länder, Ferientermine aus dem KMK-Ferienkalender 2026/27.</p>
      <p><strong>Berücksichtigt:</strong> Pfingstsonntag und -montag, Himmelfahrt und Fronleichnam 2027, Pfingstferien aller Bundesländer, Brückentage-Konstellationen.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, regionale Brauchtumstage ohne Feiertagsstatus.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Pfingsten 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Pfingstsonntag ist am <strong>16. Mai 2027</strong>, Pfingstmontag am <strong>17. Mai 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Ist Pfingstmontag 2027 ein Feiertag?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ja, der Pfingstmontag (17. Mai 2027) ist in allen Bundesländern gesetzlicher Feiertag. Der Pfingstsonntag ist nur in Brandenburg ausdrücklich gesetzlich geregelt.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Pfingstferien 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Baden-Württemberg 18.–29. Mai, Bayern 18.–28. Mai, Sachsen-Anhalt 15.–22. Mai, Hamburg 7.–14. Mai 2027. Die übrigen Länder haben keine oder nur einzelne freie Tage (meist 7. Mai und 18. Mai).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wie viele Tage liegen zwischen Ostern und Pfingsten?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">49 Tage. Ostern 2027 ist am 28. März, Pfingsten am 16. Mai 2027. Christi Himmelfahrt liegt dazwischen am 6. Mai (39 Tage nach Ostern).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Pfingsten 2028?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Pfingstsonntag 2028 ist am 4. Juni, Pfingstmontag am 5. Juni 2028.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann ist Pfingsten 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pfingstsonntag ist am 16. Mai 2027, Pfingstmontag am 17. Mai 2027."
        }
      },
      {
