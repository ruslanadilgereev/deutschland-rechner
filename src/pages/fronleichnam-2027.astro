---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Fronleichnam 2027: 27. Mai – Feiertag in welchen Bundesländern?";
const description = "Fronleichnam 2027 ist am Donnerstag, 27. Mai 2027. Gesetzlicher Feiertag in Baden-Württemberg, Bayern, Hessen, NRW, Rheinland-Pfalz und Saarland. Brückentag 28. Mai, 16 Tage frei mit Pfingsten – alle Regeln und Termine.";
const keywords = "Fronleichnam 2027, wann ist Fronleichnam 2027, Fronleichnam 2027 Bundesländer, Fronleichnam 2027 Feiertag, Brückentag Fronleichnam 2027, Fronleichnam NRW 2027, Fronleichnam Bayern 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Fronleichnam 2027", url: "/fronleichnam-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-rose-600 to-pink-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Fronleichnam 2027: Donnerstag, 27. Mai 2027</h1>
      <p class="text-white/85 text-sm mt-1">Feiertag in 6 Bundesländern · Brückentag 28. Mai · Kombination mit Pfingsten</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 text-center">
      <p class="text-sm text-gray-500 uppercase tracking-wide">Fronleichnam 2027</p>
      <p class="text-4xl sm:text-5xl font-bold text-gray-900 mt-1">Donnerstag, 27. Mai 2027</p>
    <p class="text-sm text-gray-600 mt-2" id="countdown" data-datum="2027-05-27">Tage bis 27. Mai 2027</p>
    <script is:inline>
      (function(){var el=document.getElementById('countdown');if(!el)return;var z=new Date(el.dataset.datum+'T00:00:00');var h=new Date();h.setHours(0,0,0,0);var t=Math.round((z-h)/86400000);
      if(t>1)el.textContent='Noch '+t+' Tage bis '+el.textContent.replace(/^.*?bis /,'');else if(t===1)el.textContent='Morgen ist es so weit.';else if(t===0)el.textContent='Heute!';else el.textContent='Der Termin liegt '+(-t)+' Tage zurück.';})();
    </script>
    </div>
    <p class="text-gray-700 mb-6">
      <strong>Fronleichnam 2027 ist am Donnerstag, 27. Mai 2027.</strong> Der Feiertag liegt immer 60 Tage nach
      Ostersonntag und ist gesetzlicher Feiertag in <strong>Baden-Württemberg, Bayern, Hessen, Nordrhein-Westfalen,
      Rheinland-Pfalz und dem Saarland</strong> sowie in einzelnen überwiegend katholischen Gemeinden Sachsens und Thüringens.
      In den übrigen Ländern ist der 27. Mai 2027 ein normaler Arbeitstag.
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Wo ist Fronleichnam 2027 ein Feiertag?</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Status</th><th class="py-2 pr-4">Bundesländer</th><th class="py-2 pr-4">Hinweis</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Gesetzlicher Feiertag</td><td class="py-2 whitespace-nowrap pr-4">Baden-Württemberg, Bayern, Hessen, Nordrhein-Westfalen, Rheinland-Pfalz, Saarland</td><td class="py-2">Arbeitsruhe, Geschäfte geschlossen</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Teilweise</td><td class="py-2 whitespace-nowrap pr-4">Sachsen (nach Fronleichnamsverordnung in bestimmten Gemeinden), Thüringen (Gemeinden mit überwiegend katholischer Bevölkerung)</td><td class="py-2">nur in den benannten Gemeinden</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Kein Feiertag</td><td class="py-2 whitespace-nowrap pr-4">Berlin, Brandenburg, Bremen, Hamburg, Mecklenburg-Vorpommern, Niedersachsen, Sachsen-Anhalt, Schleswig-Holstein</td><td class="py-2">normaler Arbeitstag; Freistellung für Gottesdienstbesuch möglich</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Brückentag 28. Mai 2027: 4 Tage frei mit 1 Urlaubstag</h2>
      <p class="text-sm text-gray-700 mb-3">
        In den sechs Fronleichnam-Ländern reicht der <strong>Freitag, 28. Mai 2027</strong>, für ein langes Wochenende
        (27.–30. Mai). Kombiniert mit Pfingsten: Urlaub vom 18. bis 21. Mai, 24. bis 26. Mai und am 28. Mai (8 Tage) ergibt
        <strong>16 freie Tage vom 15. bis 30. Mai 2027</strong>. In Bayern (Pfingstferien 18.–28. Mai) und Baden-Württemberg
        (18.–29. Mai) decken die Schulferien genau diesen Zeitraum ab.
      </p>
      <p class="text-sm text-gray-700">Alle Varianten je Land: <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a>.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Hintergrund und Termine der Folgejahre</h2>
      <p class="text-sm text-gray-700 mb-2">Fronleichnam („Hochfest des Leibes und Blutes Christi") wird am Donnerstag nach dem Dreifaltigkeitssonntag gefeiert, dem zweiten Donnerstag nach Pfingsten. Der Termin liegt zwischen dem 21. Mai und dem 24. Juni.</p>
      <p class="text-sm text-gray-700">Fronleichnam 2026 war am 4. Juni, Fronleichnam 2028 ist am 15. Juni.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Fronleichnam = Ostersonntag + 60 Tage (Ostern 2027: 28. März); Feiertagsstatus nach den Feiertagsgesetzen der Länder (u. a. § 1 FTG BW, Art. 1 FTG BY, § 2 FeiertagsG NRW, Sächsische Fronleichnamsverordnung).</p>
      <p><strong>Berücksichtigt:</strong> Feiertagsstatus je Bundesland einschließlich der Gemeinde-Regelungen in Sachsen und Thüringen, Brückentage, Pfingstferien.</p>
      <p><strong>Nicht berücksichtigt:</strong> Einzelne Gemeindelisten in Sachsen/Thüringen, kirchliche Freistellungsansprüche im Detail.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Fronleichnam 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Am <strong>Donnerstag, 27. Mai 2027</strong> – 60 Tage nach Ostersonntag (28. März 2027).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">In welchen Bundesländern ist Fronleichnam 2027 ein Feiertag?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">In Baden-Württemberg, Bayern, Hessen, Nordrhein-Westfalen, Rheinland-Pfalz und dem Saarland – zusätzlich in bestimmten katholisch geprägten Gemeinden Sachsens und Thüringens.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Ist Fronleichnam 2027 in Niedersachsen oder Berlin frei?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Nein. In Niedersachsen, Berlin, Brandenburg, Bremen, Hamburg, Mecklenburg-Vorpommern, Sachsen-Anhalt und Schleswig-Holstein ist der 27. Mai 2027 ein normaler Arbeitstag.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Fronleichnam 2028?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Fronleichnam 2028 ist am Donnerstag, 15. Juni 2028.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann ist Fronleichnam 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Am Donnerstag, 27. Mai 2027 – 60 Tage nach Ostersonntag (28. März 2027)."
        }
      },
      {
        "@type": "Question",
        "name": "In welchen Bundesländern ist Fronleichnam 2027 ein Feiertag?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In Baden-Württemberg, Bayern, Hessen, Nordrhein-Westfalen, Rheinland-Pfalz und dem Saarland – zusätzlich in bestimmten katholisch geprägten Gemeinden Sachsens und Thüringens."
        }
      },
      {
        "@type": "Question",
        "name": "Ist Fronleichnam 2027 in Niedersachsen oder Berlin frei?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nein. In Niedersachsen, Berlin, Brandenburg, Bremen, Hamburg, Mecklenburg-Vorpommern, Sachsen-Anhalt und Schleswig-Holstein ist der 27. Mai 2027 ein normaler Arbeitstag."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Fronleichnam 2028?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fronleichnam 2028 ist am Donnerstag, 15. Juni 2028."
        }
      }
    ]
  })} />
</Layout>
