---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Herbstferien 2027: alle Bundesländer – NRW, Bayern, Niedersachsen";
const description = "Herbstferien 2027 laut KMK-Ferienkalender 2027/28: Hessen, Rheinland-Pfalz und Saarland ab 4. Oktober, NRW 23. Oktober–6. November, Niedersachsen 16.–30. Oktober, Bayern 2.–5. November, Baden-Württemberg 2.–6. November 2027.";
const keywords = "Herbstferien 2027, Herbstferien 2027 NRW, Herbstferien 2027 Bayern, Herbstferien 2027 Niedersachsen, Herbstferien 2027 Hessen, Herbstferien 2027 Berlin, Herbstferien 2027 Baden-Württemberg";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Herbstferien 2027", url: "/herbstferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-orange-600 to-amber-700 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Herbstferien 2027: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Vom 4. Oktober (Hessen, RLP, Saarland) bis 6. November (BW, NRW) – KMK-Ferienkalender 2027/28</p>
    </div>

    <p class="text-gray-700 mb-6">Die <strong>Herbstferien 2027</strong> beginnen am <strong>4. Oktober in Hessen, Rheinland-Pfalz und dem Saarland</strong> – direkt nach dem Tag der Deutschen Einheit, der 2027 auf einen Sonntag fällt. Berlin, Brandenburg, Hamburg, Sachsen, Schleswig-Holstein und Thüringen sind ab dem 9./11. Oktober frei, Niedersachsen und Bremen vom 16./18. bis 30. Oktober. Als letzte starten <strong>Nordrhein-Westfalen (23. Oktober–6. November)</strong> sowie Bayern und Baden-Württemberg (2.–5./6. November 2027) rund um Allerheiligen.</p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Herbstferien 2027: Termine aller 16 Bundesländer</h2>
      <p class="text-sm text-gray-600 mb-3">Angegeben ist jeweils der erste und der letzte Ferientag (KMK-Ferienkalender, Stand 09.10.2025). „—" = in diesem Land keine Herbstferien.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Herbstferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">02.11. – 06.11.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">02.11. – 05.11.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">11.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">11.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">18.10. – 30.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">11.10. – 22.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">04.10. – 16.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">14.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">16.10. – 30.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">23.10. – 06.11.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">04.10. – 15.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">04.10. – 15.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">11.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">18.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">11.10. – 23.10.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">09.10. – 23.10.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Feiertage im Herbst 2027</h2>
      <p class="text-sm text-gray-700 mb-2">Tag der Deutschen Einheit: Sonntag, 3. Oktober 2027 (kein freier Werktag). Reformationstag: Sonntag, 31. Oktober 2027 (BB, HB, HH, MV, NI, SH, SN, ST, TH – ebenfalls ohne Wirkung auf die Arbeitswoche). Allerheiligen: <strong>Montag, 1. November 2027</strong> – gesetzlicher Feiertag in BW, BY, NW, RP und SL und damit ein verlängertes Wochenende zum Start der bayerischen und baden-württembergischen Herbstferien. Buß- und Bettag: Mittwoch, 17. November 2027 (nur Sachsen).</p>
      <p class="text-sm text-gray-700"><a href="/feiertage-2027" class="text-blue-600 hover:underline">Alle Feiertage 2027</a> · <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a></p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> KMK-Ferienkalender 2027/28 (Stand 09.10.2025), Ferientermine werden von den Kultusministerien der Länder festgelegt; Feiertage nach den Feiertagsgesetzen der Länder.</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag der Herbstferien 2027 in allen 16 Bundesländern, angrenzende Feiertage und Brückentage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, Sonderregelungen für Inseln (SH) und kurzfristige Änderungen der Länder.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Herbstferien 2027 in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">In Nordrhein-Westfalen vom <strong>23. Oktober bis 6. November 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Herbstferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>2. bis 5. November 2027</strong> (plus Buß- und Bettag-Regelung am 17. November als schulfreier Tag).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Herbstferien 2027 in Niedersachsen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>16. bis 30. Oktober 2027</strong>; Bremen vom 18. bis 30. Oktober.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Herbstferien 2027 in Hessen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>4. bis 16. Oktober 2027</strong> – Rheinland-Pfalz und Saarland vom 4. bis 15. Oktober.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Herbstferien 2027 in Berlin und Brandenburg?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Beide vom 11. bis 23. Oktober 2027.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann sind die Herbstferien 2027 in NRW?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In Nordrhein-Westfalen vom 23. Oktober bis 6. November 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Herbstferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 2. bis 5. November 2027 (plus Buß- und Bettag-Regelung am 17. November als schulfreier Tag)."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Herbstferien 2027 in Niedersachsen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 16. bis 30. Oktober 2027; Bremen vom 18. bis 30. Oktober."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Herbstferien 2027 in Hessen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 4. bis 16. Oktober 2027 – Rheinland-Pfalz und Saarland vom 4. bis 15. Oktober."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Herbstferien 2027 in Berlin und Brandenburg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Beide vom 11. bis 23. Oktober 2027."
        }
      }
    ]
  })} />
</Layout>
