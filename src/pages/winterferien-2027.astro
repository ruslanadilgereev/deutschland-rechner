---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Winterferien 2027: Termine je Bundesland (Februar 2027)";
const description = "Winterferien 2027 laut KMK: Berlin, Brandenburg, Sachsen-Anhalt, Thüringen 1.–6. Februar, Mecklenburg-Vorpommern und Sachsen 8.–19. Februar, Bayern (Frühjahrsferien) und Saarland 8.–12. Februar 2027. NRW, Hessen, BW, RLP, SH haben keine Winterferien.";
const keywords = "Winterferien 2027, Winterferien 2027 Berlin, Winterferien 2027 Brandenburg, Winterferien 2027 Sachsen, Winterferien 2027 Bayern, Faschingsferien 2027, Frühjahrsferien 2027, Zeugnisferien 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Winterferien 2027", url: "/winterferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-slate-600 to-blue-800 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Winterferien 2027: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Februar 2027 – Zeugnis-, Faschings- und Frühjahrsferien der Länder</p>
    </div>

    <p class="text-gray-700 mb-6">Die <strong>Winterferien 2027</strong> liegen komplett im Februar: Berlin, Brandenburg, Sachsen-Anhalt und Thüringen sind vom <strong>1. bis 6. Februar</strong> frei, Mecklenburg-Vorpommern und Sachsen vom <strong>8. bis 19. Februar 2027</strong>. Bayern (Frühjahrsferien) und das Saarland machen vom 8. bis 12. Februar Faschingsferien – passend zu Rosenmontag am 8. Februar 2027. Hamburg, Bremen und Niedersachsen haben nur ein bis zwei Zeugnistage (29. Januar bzw. 1./2. Februar). Nordrhein-Westfalen, Hessen, Baden-Württemberg, Rheinland-Pfalz und Schleswig-Holstein haben keine Winterferien.</p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Winterferien 2027: Termine aller 16 Bundesländer</h2>
      <p class="text-sm text-gray-600 mb-3">Angegeben ist jeweils der erste und der letzte Ferientag (KMK-Ferienkalender, Stand 09.10.2025). „—" = in diesem Land keine Winterferien.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Winterferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 06.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 06.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 02.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">29.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">08.02. – 19.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 02.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">08.02. – 12.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">08.02. – 19.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 06.02.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">01.02. – 06.02.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Karneval und Winterferien 2027</h2>
      <p class="text-sm text-gray-700 mb-2">Weiberfastnacht ist am 4. Februar, Rosenmontag am 8. Februar, Aschermittwoch am 10. Februar 2027 – kein Karnevalstag ist ein gesetzlicher Feiertag. In NRW nutzen viele Schulen ihre beweglichen Ferientage für Rosenmontag und Veilchendienstag; verbindlich ist das nicht.</p>
      <p class="text-sm text-gray-700"><a href="/karneval-2027" class="text-blue-600 hover:underline">Karneval 2027</a> · <a href="/schulferien-2027" class="text-blue-600 hover:underline">Schulferien 2027</a></p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> KMK-Ferienkalender 2026/27 (Stand 09.10.2025), Ferientermine werden von den Kultusministerien der Länder festgelegt; Feiertage nach den Feiertagsgesetzen der Länder.</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag der Winterferien 2027 in allen 16 Bundesländern, angrenzende Feiertage und Brückentage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, Sonderregelungen für Inseln (SH) und kurzfristige Änderungen der Länder.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Winterferien 2027 in Berlin?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>1. bis 6. Februar 2027</strong> – ebenso in Brandenburg, Sachsen-Anhalt und Thüringen.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Winterferien 2027 in Sachsen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>8. bis 19. Februar 2027</strong>; Mecklenburg-Vorpommern hat denselben Zeitraum.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Faschingsferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Die bayerischen Frühjahrsferien 2027 liegen vom 8. bis 12. Februar 2027 – die Woche von Rosenmontag (8. Februar).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Gibt es 2027 Winterferien in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Nein. NRW hat keine Winterferien; Schulen können bewegliche Ferientage z. B. auf Rosenmontag legen.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann sind die Winterferien 2027 in Berlin?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 1. bis 6. Februar 2027 – ebenso in Brandenburg, Sachsen-Anhalt und Thüringen."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Winterferien 2027 in Sachsen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 8. bis 19. Februar 2027; Mecklenburg-Vorpommern hat denselben Zeitraum."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Faschingsferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Die bayerischen Frühjahrsferien 2027 liegen vom 8. bis 12. Februar 2027 – die Woche von Rosenmontag (8. Februar)."
        }
      },
      {
        "@type": "Question",
        "name": "Gibt es 2027 Winterferien in NRW?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nein. NRW hat keine Winterferien; Schulen können bewegliche Ferientage z. B. auf Rosenmontag legen."
        }
      }
    ]
  })} />
</Layout>
