---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Pfingstferien 2027: Bayern, Baden-Württemberg & alle Bundesländer";
const description = "Pfingstferien 2027 laut KMK: Baden-Württemberg 18.–29. Mai, Bayern 18.–28. Mai, Sachsen-Anhalt 15.–22. Mai, Hamburg 7.–14. Mai 2027. Die übrigen Länder haben nur einzelne freie Tage um Himmelfahrt (7. Mai) und Pfingstmontag (17. Mai 2027).";
const keywords = "Pfingstferien 2027, Pfingstferien 2027 Bayern, Pfingstferien 2027 Baden-Württemberg, Pfingstferien 2027 NRW, Pfingsten 2027, Ferien Pfingsten 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Pfingstferien 2027", url: "/pfingstferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-sky-500 to-cyan-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Pfingstferien 2027: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Pfingsten am 16./17. Mai 2027 – zweiwöchige Ferien in Bayern und Baden-Württemberg</p>
    </div>

    <p class="text-gray-700 mb-6">Echte zweiwöchige <strong>Pfingstferien 2027</strong> gibt es nur in <strong>Baden-Württemberg (18.–29. Mai)</strong> und <strong>Bayern (18.–28. Mai)</strong>; Sachsen-Anhalt ist vom 15. bis 22. Mai frei, Hamburg legt seine Frühjahrspause auf den 7.–14. Mai. Die meisten anderen Länder gewähren nur einzelne bewegliche Tage – typischerweise den Freitag nach Himmelfahrt (7. Mai) und den Dienstag nach Pfingsten (18. Mai 2027). Hessen, Rheinland-Pfalz und das Saarland haben keine Pfingstferien.</p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Pfingstferien 2027: Termine aller 16 Bundesländer</h2>
      <p class="text-sm text-gray-600 mb-3">Angegeben ist jeweils der erste und der letzte Ferientag (KMK-Ferienkalender, Stand 09.10.2025). „—" = in diesem Land keine Pfingstferien.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Pfingstferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">18.05. – 29.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">18.05. – 28.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 18.05. – 19.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">07.05. und 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">07.05. – 14.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 14.05. – 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">07.05. und 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">—</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">07.05. sowie 15.05. – 18.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">15.05. – 22.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">07.05.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">07.05.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Feiertage rund um die Pfingstferien 2027</h2>
      <p class="text-sm text-gray-700 mb-2">Christi Himmelfahrt Donnerstag 6. Mai, Pfingstmontag 17. Mai und Fronleichnam Donnerstag 27. Mai 2027 (BW, BY, HE, NW, RP, SL) liegen alle im Ferienfenster. In Bayern und Baden-Württemberg reichen <strong>8 Urlaubstage für 16 freie Tage vom 15. bis 30. Mai 2027</strong>.</p>
      <p class="text-sm text-gray-700"><a href="/pfingsten-2027" class="text-blue-600 hover:underline">Pfingsten 2027</a> · <a href="/christi-himmelfahrt-2027" class="text-blue-600 hover:underline">Himmelfahrt 2027</a> · <a href="/fronleichnam-2027" class="text-blue-600 hover:underline">Fronleichnam 2027</a> · <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a></p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> KMK-Ferienkalender 2026/27 (Stand 09.10.2025), Ferientermine werden von den Kultusministerien der Länder festgelegt; Feiertage nach den Feiertagsgesetzen der Länder.</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag der Pfingstferien 2027 in allen 16 Bundesländern, angrenzende Feiertage und Brückentage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, Sonderregelungen für Inseln (SH) und kurzfristige Änderungen der Länder.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Pfingstferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>18. bis 28. Mai 2027</strong> (Dienstag nach Pfingsten bis Freitag nach Fronleichnam).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Pfingstferien 2027 in Baden-Württemberg?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>18. bis 29. Mai 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Gibt es 2027 Pfingstferien in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Nur einen Tag: Dienstag, 18. Mai 2027 (Pfingstdienstag) ist in NRW schulfrei.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Pfingsten 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Pfingstsonntag 16. Mai, Pfingstmontag 17. Mai 2027.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann sind die Pfingstferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 18. bis 28. Mai 2027 (Dienstag nach Pfingsten bis Freitag nach Fronleichnam)."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Pfingstferien 2027 in Baden-Württemberg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 18. bis 29. Mai 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Gibt es 2027 Pfingstferien in NRW?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nur einen Tag: Dienstag, 18. Mai 2027 (Pfingstdienstag) ist in NRW schulfrei."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Pfingsten 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pfingstsonntag 16. Mai, Pfingstmontag 17. Mai 2027."
        }
      }
    ]
  })} />
</Layout>
