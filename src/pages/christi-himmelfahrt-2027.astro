---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Christi Himmelfahrt 2027: 6. Mai – Vatertag, Brückentag & Feiertage";
const description = "Wann ist Christi Himmelfahrt 2027? Am Donnerstag, 6. Mai 2027 – bundesweiter Feiertag und Vatertag. Brückentag 7. Mai, 12 Tage frei bis Pfingsten mit 6 Urlaubstagen, alle Feiertage im Mai 2027.";
const keywords = "Christi Himmelfahrt 2027, Himmelfahrt 2027, Vatertag 2027, wann ist Himmelfahrt 2027, Brückentag Himmelfahrt 2027, Feiertage Mai 2027, Vatertag 2027 Datum";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Christi Himmelfahrt 2027", url: "/christi-himmelfahrt-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-indigo-600 to-violet-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Christi Himmelfahrt 2027: Donnerstag, 6. Mai 2027</h1>
      <p class="text-white/85 text-sm mt-1">Vatertag · Brückentag 7. Mai · alle Feiertage im Mai 2027</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 text-center">
      <p class="text-sm text-gray-500 uppercase tracking-wide">Christi Himmelfahrt &amp; Vatertag 2027</p>
      <p class="text-4xl sm:text-5xl font-bold text-gray-900 mt-1">Donnerstag, 6. Mai 2027</p>
    <p class="text-sm text-gray-600 mt-2" id="countdown" data-datum="2027-05-06">Tage bis 6. Mai 2027</p>
    <script is:inline>
      (function(){var el=document.getElementById('countdown');if(!el)return;var z=new Date(el.dataset.datum+'T00:00:00');var h=new Date();h.setHours(0,0,0,0);var t=Math.round((z-h)/86400000);
      if(t>1)el.textContent='Noch '+t+' Tage bis '+el.textContent.replace(/^.*?bis /,'');else if(t===1)el.textContent='Morgen ist es so weit.';else if(t===0)el.textContent='Heute!';else el.textContent='Der Termin liegt '+(-t)+' Tage zurück.';})();
    </script>
    </div>
    <p class="text-gray-700 mb-6">
      <strong>Christi Himmelfahrt 2027 ist am Donnerstag, 6. Mai 2027</strong> – bundesweit gesetzlicher Feiertag und
      zugleich <strong>Vatertag</strong>. Der Freitag, 7. Mai, ist der klassische Brückentag des Jahres: ein Urlaubstag,
      vier freie Tage. Himmelfahrt liegt immer 39 Tage nach Ostersonntag (28. März 2027) und zehn Tage vor Pfingsten
      (16./17. Mai).
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Brückentag 7. Mai 2027: 1 Urlaubstag = 4 Tage frei</h2>
      <p class="text-sm text-gray-700 mb-3">
        Mit dem <strong>Freitag, 7. Mai 2027</strong> als Urlaubstag sind Sie von Donnerstag bis Sonntag (6.–9. Mai) frei.
        Wer die ganze Folgewoche (10.–14. Mai) anhängt, erreicht mit <strong>6 Urlaubstagen 12 freie Tage bis Pfingstmontag
        (6.–17. Mai 2027)</strong>. In mehreren Ländern ist der 7. Mai ohnehin schulfrei: Berlin, Bremen, Hamburg (7.–14. Mai),
        Mecklenburg-Vorpommern, Niedersachsen, Sachsen, Schleswig-Holstein und Thüringen.
      </p>
      <p class="text-sm text-gray-700">Alle Konstellationen je Bundesland: <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a>.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Die Feiertage im Mai 2027 im Überblick</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Datum</th><th class="py-2 pr-4">Tag</th><th class="py-2 pr-4">Status</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sa 01.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Tag der Arbeit</td><td class="py-2">bundesweiter Feiertag – fällt 2027 auf einen Samstag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 06.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Christi Himmelfahrt / Vatertag</td><td class="py-2">bundesweiter gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Fr 07.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Brückentag</td><td class="py-2">Werktag – in 8 Ländern beweglicher Ferientag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 09.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Muttertag</td><td class="py-2">zweiter Sonntag im Mai, kein gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mo 17.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Pfingstmontag</td><td class="py-2">bundesweiter gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 27.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Fronleichnam</td><td class="py-2">Feiertag in BW, BY, HE, NW, RP, SL</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Vatertag 2027: Datum und Regeln</h2>
      <p class="text-sm text-gray-700 mb-2">Der Vatertag (Herrentag, Männertag) fällt in Deutschland immer auf Christi Himmelfahrt, 2027 also auf den <strong>6. Mai</strong>. Er ist damit – anders als der Muttertag am Sonntag, 9. Mai 2027 – ein gesetzlicher Feiertag mit Arbeitsruhe. Geschäfte bleiben geschlossen; Tanz- oder Musikverbote wie an stillen Feiertagen gelten nicht.</p>
      <p class="text-sm text-gray-700">Himmelfahrt 2026 war am 14. Mai, Himmelfahrt 2028 ist am 25. Mai.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Christi Himmelfahrt = Ostersonntag + 39 Tage (Ostern 2027: 28. März); gesetzlicher Feiertag nach den Feiertagsgesetzen aller 16 Länder; Ferientermine aus dem KMK-Ferienkalender 2026/27.</p>
      <p><strong>Berücksichtigt:</strong> Himmelfahrt/Vatertag, Brückentag 7. Mai, Muttertag, Pfingsten und Fronleichnam 2027, bewegliche Ferientage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Betriebliche Brückentagsregelungen, Ladenöffnung in Touristenorten, regionale Bräuche.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Christi Himmelfahrt 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Am <strong>Donnerstag, 6. Mai 2027</strong>. Es ist ein bundesweiter gesetzlicher Feiertag.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Vatertag 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vatertag ist in Deutschland immer an Christi Himmelfahrt, 2027 also am Donnerstag, 6. Mai 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Ist der 7. Mai 2027 ein Brückentag?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ja. Freitag, 7. Mai 2027, liegt zwischen Himmelfahrt und dem Wochenende. Ein Urlaubstag ergibt vier freie Tage (6.–9. Mai); in Berlin, Bremen, Hamburg, MV, Niedersachsen, Sachsen, Schleswig-Holstein und Thüringen ist er beweglicher Ferientag.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Himmelfahrt 2028?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Christi Himmelfahrt 2028 ist am Donnerstag, 25. Mai 2028.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann ist Christi Himmelfahrt 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Am Donnerstag, 6. Mai 2027. Es ist ein bundesweiter gesetzlicher Feiertag."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Vatertag 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vatertag ist in Deutschland immer an Christi Himmelfahrt, 2027 also am Donnerstag, 6. Mai 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Ist der 7. Mai 2027 ein Brückentag?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Freitag, 7. Mai 2027, liegt zwischen Himmelfahrt und dem Wochenende. Ein Urlaubstag ergibt vier freie Tage (6.–9. Mai); in Berlin, Bremen, Hamburg, MV, Niedersachsen, Sachsen, Schleswig-Holstein und Thüringen ist er beweglicher Ferientag."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Himmelfahrt 2028?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Christi Himmelfahrt 2028 ist am Donnerstag, 25. Mai 2028."
        }
      }
    ]
  })} />
</Layout>
