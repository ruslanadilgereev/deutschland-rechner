---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Karneval 2027: Rosenmontag 8. Februar, Weiberfastnacht, Aschermittwoch";
const description = "Karneval und Fasching 2027: Weiberfastnacht 4. Februar, Rosenmontag 8. Februar, Faschingsdienstag 9. Februar, Aschermittwoch 10. Februar 2027. Alle Termine, Rechtslage (kein Feiertag), Winterferien und Urlaubstipps.";
const keywords = "Karneval 2027, Rosenmontag 2027, Fasching 2027, Fastnacht 2027, Weiberfastnacht 2027, Aschermittwoch 2027, Faschingsdienstag 2027, wann ist Karneval 2027, Karneval 2027 Termine";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Karneval 2027", url: "/karneval-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-fuchsia-600 to-purple-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Karneval 2027: Rosenmontag am 8. Februar 2027</h1>
      <p class="text-white/85 text-sm mt-1">Weiberfastnacht 4. Februar · Faschingsdienstag 9. Februar · Aschermittwoch 10. Februar 2027</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 text-center">
      <p class="text-sm text-gray-500 uppercase tracking-wide">Rosenmontag 2027</p>
      <p class="text-4xl sm:text-5xl font-bold text-gray-900 mt-1">Montag, 8. Februar 2027</p>
    <p class="text-sm text-gray-600 mt-2" id="countdown" data-datum="2027-02-08">Tage bis 8. Februar 2027</p>
    <script is:inline>
      (function(){var el=document.getElementById('countdown');if(!el)return;var z=new Date(el.dataset.datum+'T00:00:00');var h=new Date();h.setHours(0,0,0,0);var t=Math.round((z-h)/86400000);
      if(t>1)el.textContent='Noch '+t+' Tage bis '+el.textContent.replace(/^.*?bis /,'');else if(t===1)el.textContent='Morgen ist es so weit.';else if(t===0)el.textContent='Heute!';else el.textContent='Der Termin liegt '+(-t)+' Tage zurück.';})();
    </script>
    </div>
    <p class="text-gray-700 mb-6">
      <strong>Rosenmontag 2027 ist am 8. Februar 2027</strong>, Weiberfastnacht am Donnerstag, 4. Februar, Fastnachtsdienstag
      (Faschingsdienstag) am 9. Februar und Aschermittwoch am 10. Februar 2027. Karneval liegt damit 2027 sehr früh, weil
      Ostern bereits am 28. März ist: Der Rosenmontag ist immer 48 Tage vor Ostersonntag. <strong>Kein Karnevalstag ist ein
      gesetzlicher Feiertag</strong> – frei gibt es nur per Urlaub, Betriebsvereinbarung oder Brauchtumsregelung.
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Alle Karnevals- und Faschingstermine 2027</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Datum</th><th class="py-2 pr-4">Tag</th><th class="py-2 pr-4">Hinweis</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mi 11.11.2026</td><td class="py-2 whitespace-nowrap pr-4">Sessionsbeginn 11.11.</td><td class="py-2">Auftakt der Session 2026/27 um 11:11 Uhr</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 04.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Weiberfastnacht / Altweiber / Schmotziger Dunschtig</td><td class="py-2">Straßenkarneval beginnt; in NRW vielerorts Arbeitsende mittags per Vereinbarung</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Fr 05.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Rußiger Freitag</td><td class="py-2">regional (schwäbisch-alemannische Fastnacht)</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sa 06.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Nelkensamstag</td><td class="py-2">Umzüge in vielen Städten</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 07.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Tulpensonntag / Fastnachtssonntag</td><td class="py-2">Schull- un Veedelszöch in Köln</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mo 08.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Rosenmontag</td><td class="py-2">Umzüge in Köln, Düsseldorf, Mainz; kein gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Di 09.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Veilchendienstag / Faschingsdienstag</td><td class="py-2">Ende des Straßenkarnevals, Nubbelverbrennung</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mi 10.02.2027</td><td class="py-2 whitespace-nowrap pr-4">Aschermittwoch</td><td class="py-2">Beginn der 40-tägigen Fastenzeit</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 28.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Ostersonntag</td><td class="py-2">Ende der Fastenzeit</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Frei an Rosenmontag 2027? Rechtslage und Ferien</h2>
      <p class="text-sm text-gray-700 mb-3">
        Rosenmontag und Faschingsdienstag sind in keinem Bundesland gesetzliche Feiertage (Feiertagsgesetze der Länder). In
        den Karnevalshochburgen (Köln, Düsseldorf, Mainz, Aachen, Bonn) gewähren viele Arbeitgeber freiwillig oder per
        Betriebsvereinbarung frei; ein Rechtsanspruch entsteht nur bei betrieblicher Übung. Wer sicher frei haben will,
        nimmt <strong>Urlaub für Montag und Dienstag (8./9. Februar)</strong> – das ergibt mit dem Wochenende vier Tage.
      </p>
      <p class="text-sm text-gray-700 mb-3">
        <strong>Winterferien 2027</strong> decken die Karnevalstage in mehreren Ländern ab: Bayern (Frühjahrsferien 8.–12. Februar),
        Saarland (8.–12. Februar), Mecklenburg-Vorpommern und Sachsen (8.–19. Februar). Berlin, Brandenburg, Sachsen-Anhalt
        und Thüringen haben ihre Winterferien bereits 1.–6. Februar, NRW, Hessen, Baden-Württemberg und Rheinland-Pfalz
        haben keine Winterferien (in NRW sind Rosenmontag/Veilchendienstag oft bewegliche Ferientage der Schulen).
      </p>
      <p class="text-sm text-gray-700">Alle Ferien: <a href="/winterferien-2027" class="text-blue-600 hover:underline">Winterferien 2027</a> · Urlaubsplanung: <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a></p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Warum ist Karneval 2027 so früh?</h2>
      <p class="text-sm text-gray-700 mb-2">Der Karnevalstermin hängt am Osterdatum: Aschermittwoch ist 46 Tage vor Ostersonntag, Rosenmontag 48 Tage davor. Ostern 2027 fällt auf den 28. März – einen der frühesten Termine der Dekade – daher Rosenmontag am 8. Februar. Frühestmöglich ist der 2. Februar, spätestmöglich der 8. März.</p>
      <p class="text-sm text-gray-700">Zum Vergleich: Rosenmontag 2026 war am 16. Februar, Rosenmontag 2028 ist am 28. Februar.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Karnevalstermine leiten sich vom Osterdatum ab (Rosenmontag = Ostersonntag − 48 Tage; Ostern 2027: 28. März). Feiertagsstatus nach den Feiertagsgesetzen der Länder, Ferientermine aus dem KMK-Ferienkalender 2026/27.</p>
      <p><strong>Berücksichtigt:</strong> Alle Karnevals-/Fastnachtstage 2027 von Weiberfastnacht bis Aschermittwoch, Rechtslage zur Arbeitsfreistellung, Winterferien der Länder.</p>
      <p><strong>Nicht berücksichtigt:</strong> Lokale Umzugszeiten, Sonderregelungen einzelner Betriebe und Schulen, Fastnachtsbräuche außerhalb Deutschlands.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Rosenmontag 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Rosenmontag 2027 ist am <strong>8. Februar 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Weiberfastnacht 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Weiberfastnacht (Altweiber, Schmotziger Donnerstag) ist am Donnerstag, 4. Februar 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Aschermittwoch 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Aschermittwoch ist am 10. Februar 2027 – 46 Tage vor Ostersonntag (28. März 2027).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Ist Rosenmontag 2027 ein Feiertag?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Nein. Rosenmontag ist in keinem Bundesland gesetzlicher Feiertag. Frei gibt es nur durch Urlaub, Betriebsvereinbarung oder betriebliche Übung – in NRW oft als halber oder ganzer freiwilliger Tag.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Fasching 2028?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Rosenmontag 2028 ist am 28. Februar, Aschermittwoch am 1. März 2028 (Ostern 2028: 16. April).</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann ist Rosenmontag 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rosenmontag 2027 ist am 8. Februar 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Weiberfastnacht 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Weiberfastnacht (Altweiber, Schmotziger Donnerstag) ist am Donnerstag, 4. Februar 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Aschermittwoch 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Aschermittwoch ist am 10. Februar 2027 – 46 Tage vor Ostersonntag (28. März 2027)."
        }
      },
      {
        "@type": "Question",
        "name": "Ist Rosenmontag 2027 ein Feiertag?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nein. Rosenmontag ist in keinem Bundesland gesetzlicher Feiertag. Frei gibt es nur durch Urlaub, Betriebsvereinbarung oder betriebliche Übung – in NRW oft als halber oder ganzer freiwilliger Tag."
        }
      },
      {
        "@type": "Question",
        "name": "Wann ist Fasching 2028?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rosenmontag 2028 ist am 28. Februar, Aschermittwoch am 1. März 2028 (Ostern 2028: 16. April)."
        }
      }
    ]
  })} />
</Layout>
