---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Ostern 2027: 28. März – Karfreitag, Ostermontag & Brückentage";
const description = "Wann ist Ostern 2027? Ostersonntag ist am 28. März 2027, Karfreitag am 26. März, Ostermontag am 29. März. Alle Termine, Feiertage je Bundesland, Osterferien 2027 und der beste Brückentage-Plan (9 Tage frei mit 4 Urlaubstagen).";
const keywords = "Ostern 2027, wann ist Ostern 2027, Ostersonntag 2027, Karfreitag 2027, Ostermontag 2027, Osterferien 2027, Ostern 2027 Datum, Osterwochenende 2027, Brückentage Ostern 2027";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Ostern 2027", url: "/ostern-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-emerald-600 to-teal-600 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Ostern 2027: Sonntag, 28. März 2027</h1>
      <p class="text-white/85 text-sm mt-1">Karfreitag 26. März · Ostermontag 29. März · Osterferien und Brückentage aller Bundesländer</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 text-center">
      <p class="text-sm text-gray-500 uppercase tracking-wide">Ostersonntag 2027</p>
      <p class="text-4xl sm:text-5xl font-bold text-gray-900 mt-1">Sonntag, 28. März 2027</p>
    <p class="text-sm text-gray-600 mt-2" id="countdown" data-datum="2027-03-28">Tage bis 28. März 2027</p>
    <script is:inline>
      (function(){var el=document.getElementById('countdown');if(!el)return;var z=new Date(el.dataset.datum+'T00:00:00');var h=new Date();h.setHours(0,0,0,0);var t=Math.round((z-h)/86400000);
      if(t>1)el.textContent='Noch '+t+' Tage bis '+el.textContent.replace(/^.*?bis /,'');else if(t===1)el.textContent='Morgen ist es so weit.';else if(t===0)el.textContent='Heute!';else el.textContent='Der Termin liegt '+(-t)+' Tage zurück.';})();
    </script>
    </div>
    <p class="text-gray-700 mb-6">
      <strong>Ostern 2027 ist am Sonntag, 28. März 2027.</strong> Karfreitag fällt auf den 26. März, Ostermontag auf den
      29. März 2027. Damit liegt Ostern 2027 ungewöhnlich früh – früher als 2026 (5. April) und 2028 (16. April).
      Beide Feiertage sind bundesweit gesetzlich, das Osterwochenende bringt also <strong>vier freie Tage am Stück ohne
      einen einzigen Urlaubstag</strong>. In der Nacht zum Ostersonntag beginnt außerdem die Sommerzeit.
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Alle Termine rund um Ostern 2027</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Datum</th><th class="py-2 pr-4">Tag</th><th class="py-2 pr-4">Status</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 21.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Palmsonntag</td><td class="py-2">Beginn der Karwoche</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 25.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Gründonnerstag</td><td class="py-2">kein gesetzlicher Feiertag (BW: beweglicher Ferientag)</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Fr 26.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Karfreitag</td><td class="py-2">bundesweiter gesetzlicher Feiertag, stiller Feiertag (Tanzverbot in allen Ländern)</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sa 27.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Karsamstag</td><td class="py-2">normaler Werktag, Geschäfte geöffnet</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So 28.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Ostersonntag</td><td class="py-2">Feiertag; gesetzlich nur in Brandenburg – zugleich Beginn der Sommerzeit (2:00 → 3:00 Uhr)</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mo 29.03.2027</td><td class="py-2 whitespace-nowrap pr-4">Ostermontag</td><td class="py-2">bundesweiter gesetzlicher Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 06.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Christi Himmelfahrt</td><td class="py-2">39 Tage nach Ostern – bundesweiter Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">So/Mo 16./17.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Pfingsten</td><td class="py-2">49 Tage nach Ostern – Pfingstmontag bundesweiter Feiertag</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Do 27.05.2027</td><td class="py-2 whitespace-nowrap pr-4">Fronleichnam</td><td class="py-2">60 Tage nach Ostern – Feiertag in BW, BY, HE, NW, RP, SL</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Brückentage an Ostern 2027: 10 Tage frei mit 4 Urlaubstagen</h2>
      <p class="text-sm text-gray-700 mb-3">
        Karfreitag (Fr) und Ostermontag (Mo) rahmen das Wochenende ein. Wer die vier Werktage <strong>Dienstag 30. März bis
        Freitag 2. April 2027</strong> als Urlaub nimmt, ist von Samstag, 27. März, bis Sonntag, 4. April frei – <strong>9 Tage
        am Stück für 4 Urlaubstage</strong>. Mit den vier Tagen davor (22.–25. März) werden es 16 Tage für 8 Urlaubstage.
        In Bayern, Berlin, Brandenburg, Hessen, Niedersachsen, NRW, Rheinland-Pfalz und Thüringen liegen die Osterferien
        genau in diesem Fenster (22. März bis 2./3. April).
      </p>
      <p class="text-sm text-gray-700">Alle Varianten je Bundesland rechnet der <a href="/brueckentage-rechner" class="text-blue-600 hover:underline">Brückentage-Rechner</a>, den Urlaubsanspruch der <a href="/urlaubstage-rechner" class="text-blue-600 hover:underline">Urlaubstage-Rechner</a>.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Osterferien 2027 je Bundesland</h2>
      <p class="text-sm text-gray-600 mb-3">Erster und letzter Ferientag laut KMK-Ferienkalender 2026/27 (Stand 09.10.2025). Hamburg legt seine Frühjahrsferien vor Ostern, Bayern hat zusätzlich Frühjahrsferien im Februar.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Osterferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">25.03. sowie 30.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">08.02. – 12.02. (Frühjahr) sowie 22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">01.03. – 12.03.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">24.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">30.03. – 09.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">26.03. – 02.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 27.03.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">30.03. – 10.04.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">22.03. – 03.04.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Vollständige Übersicht aller Ferien: <a href="/osterferien-2027" class="text-blue-600 hover:underline">Osterferien 2027</a> · <a href="/schulferien-2027" class="text-blue-600 hover:underline">Schulferien 2027</a></p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Warum ist Ostern 2027 so früh? Die Osterformel</h2>
      <p class="text-sm text-gray-700 mb-2">
        Ostern ist der <strong>erste Sonntag nach dem ersten Vollmond des Frühlings</strong> (Konzil von Nicäa, 325). Der
        kirchliche Frühlingsanfang ist fest der 21. März; 2027 fällt der erste Frühlingsvollmond auf Montag, 22. März,
        der nächste Sonntag ist der 28. März. Frühestmöglicher Ostertermin ist der 22. März, spätester der 25. April.
      </p>
      <p class="text-sm text-gray-700">Zum Vergleich: Ostern 2026 war am 5. April, Ostern 2028 ist am 16. April, Ostern 2029 am 1. April. Alle beweglichen Feiertage 2027 (Himmelfahrt, Pfingsten, Fronleichnam) leiten sich vom 28. März ab.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Ostertermin nach der Gauß'schen Osterformel (erster Sonntag nach dem ersten Frühlingsvollmond), Feiertagsstatus nach den Feiertagsgesetzen der 16 Länder, Ferientermine aus dem KMK-Ferienkalender 2026/27.</p>
      <p><strong>Berücksichtigt:</strong> Karfreitag, Ostersonntag, Ostermontag, die davon abgeleiteten Feiertage 2027, Osterferien aller Bundesländer, Brückentage-Konstellationen, Beginn der Sommerzeit.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, orthodoxes Osterdatum (2. Mai 2027), kirchliche Sonderregelungen.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Ostern 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ostersonntag 2027 ist am <strong>28. März 2027</strong>. Karfreitag ist am Freitag, 26. März, Ostermontag am Montag, 29. März 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Ist Karfreitag 2027 ein gesetzlicher Feiertag?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ja, Karfreitag (26. März 2027) und Ostermontag (29. März 2027) sind in allen 16 Bundesländern gesetzliche Feiertage. Der Ostersonntag ist nur in Brandenburg ausdrücklich gesetzlicher Feiertag – als Sonntag ist er ohnehin arbeitsfrei.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wie viele Urlaubstage brauche ich für zwei Wochen frei an Ostern 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Acht: 22.–25. März und 30. März–2. April 2027. Zusammen mit Karfreitag, Ostermontag und drei Wochenenden ergibt das 16 freie Tage vom 20. März bis 4. April 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Osterferien 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">In den meisten Ländern vom 22. März bis 2./3. April 2027 (Bayern, Berlin, Brandenburg, Bremen, Hessen, Niedersachsen, NRW, Rheinland-Pfalz, Thüringen). Baden-Württemberg: 25. März sowie 30. März–3. April, Saarland 30. März–9. April, Schleswig-Holstein 30. März–10. April, Hamburg bereits 1.–12. März 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann ist Ostern 2028?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Ostersonntag 2028 ist am 16. April 2028 (Karfreitag 14. April, Ostermontag 17. April). Ostern 2026 war am 5. April.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

