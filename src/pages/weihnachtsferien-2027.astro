---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Weihnachtsferien 2027/2028: alle Bundesländer – Termine & Brückentage";
const description = "Weihnachtsferien 2027/28 laut KMK-Ferienkalender 2027/28: die meisten Länder vom 23. Dezember 2027 bis 8. Januar 2028, Hamburg, Saarland, Sachsen-Anhalt ab 20. Dezember, Hessen bis 11. Januar. Weihnachten 2027 fällt auf Samstag/Sonntag – so sparen Sie Urlaubstage.";
const keywords = "Weihnachtsferien 2027, Weihnachtsferien 2027/2028, Weihnachtsferien 2027 NRW, Weihnachtsferien 2027 Bayern, Weihnachtsferien 2027 Niedersachsen, Weihnachten 2027, Silvester 2027 Wochentag";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Weihnachtsferien 2027", url: "/weihnachtsferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-red-700 to-emerald-700 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Weihnachtsferien 2027/2028: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Weihnachten 2027 am Wochenende – Ferien meist vom 23. Dezember bis 8. Januar 2028</p>
    </div>

    <p class="text-gray-700 mb-6">Die <strong>Weihnachtsferien 2027/2028</strong> beginnen in den meisten Ländern am <strong>Donnerstag, 23. Dezember 2027</strong> und enden am <strong>8. Januar 2028</strong> (Baden-Württemberg, Bremen, Niedersachsen, NRW ab 24.12., Schleswig-Holstein); Hamburg, das Saarland und Sachsen-Anhalt starten bereits am 20. Dezember, Hessen macht bis zum 11. Januar 2028 frei, Berlin, Brandenburg, Sachsen und Thüringen nur bis zum 31. Dezember bzw. 1. Januar. Besonderheit 2027: <strong>Heiligabend ist ein Freitag, der 1. und 2. Weihnachtstag fallen auf Samstag und Sonntag</strong>, Silvester ist ein Freitag, Neujahr 2028 ein Samstag – die Feiertage bringen Arbeitnehmern also keinen zusätzlichen freien Werktag.</p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Weihnachtsferien 2027: Termine aller 16 Bundesländer</h2>
      <p class="text-sm text-gray-600 mb-3">Angegeben ist jeweils der erste und der letzte Ferientag (KMK-Ferienkalender, Stand 09.10.2025). „—" = in diesem Land keine Weihnachtsferien.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Weihnachtsferien 2027</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 08.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">24.12. – 07.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">22.12. – 31.12.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 31.12.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 08.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">20.12. – 31.12.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 11.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">22.12. – 04.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 08.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">24.12. – 08.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 07.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">20.12. – 31.12.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 01.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">20.12. – 31.12.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 08.01.</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">23.12. – 31.12.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Urlaub zwischen den Jahren 2027/28</h2>
      <p class="text-sm text-gray-700 mb-2">Weil die Feiertage aufs Wochenende fallen, kosten die zwei Wochen vom 25. Dezember 2027 bis 9. Januar 2028 volle <strong>10 Urlaubstage</strong> (27.–31. Dezember und 3.–7. Januar; Heiligabend und Silvester sind keine gesetzlichen Feiertage, oft aber tariflich halb oder ganz frei). Die Kernzeit „zwischen den Jahren" (27.–31. Dezember) sind 5 Urlaubstage für 9 freie Tage (25. Dezember–2. Januar). Heilige Drei Könige (6. Januar 2028) ist ein Donnerstag – in BW, BY und ST ein Feiertag mit Brückentag am 7. Januar.</p>
      <p class="text-sm text-gray-700"><a href="/feiertage-2027" class="text-blue-600 hover:underline">Feiertage 2027</a> · <a href="/urlaubstage-rechner" class="text-blue-600 hover:underline">Urlaubstage-Rechner</a></p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> KMK-Ferienkalender 2027/28 (Stand 09.10.2025), Ferientermine werden von den Kultusministerien der Länder festgelegt; Feiertage nach den Feiertagsgesetzen der Länder.</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag der Weihnachtsferien 2027 in allen 16 Bundesländern, angrenzende Feiertage und Brückentage.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage einzelner Schulen, Sonderregelungen für Inseln (SH) und kurzfristige Änderungen der Länder.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Weihnachtsferien 2027 in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>24. Dezember 2027 bis 8. Januar 2028</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Weihnachtsferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>24. Dezember 2027 bis 7. Januar 2028</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Weihnachtsferien 2027 in Niedersachsen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom 23. Dezember 2027 bis 8. Januar 2028 – ebenso Bremen, Baden-Württemberg und Schleswig-Holstein.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Auf welchen Wochentag fällt Weihnachten 2027?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Heiligabend ist Freitag, der 24. Dezember 2027; der 1. Weihnachtstag ist ein Samstag, der 2. Weihnachtstag ein Sonntag. Silvester 2027 ist ein Freitag, Neujahr 2028 ein Samstag.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wann sind die Weihnachtsferien 2027 in NRW?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 24. Dezember 2027 bis 8. Januar 2028."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Weihnachtsferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 24. Dezember 2027 bis 7. Januar 2028."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Weihnachtsferien 2027 in Niedersachsen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 23. Dezember 2027 bis 8. Januar 2028 – ebenso Bremen, Baden-Württemberg und Schleswig-Holstein."
        }
      },
      {
        "@type": "Question",
        "name": "Auf welchen Wochentag fällt Weihnachten 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Heiligabend ist Freitag, der 24. Dezember 2027; der 1. Weihnachtstag ist ein Samstag, der 2. Weihnachtstag ein Sonntag. Silvester 2027 ist ein Freitag, Neujahr 2028 ein Samstag."
        }
      }
    ]
  })} />
</Layout>
