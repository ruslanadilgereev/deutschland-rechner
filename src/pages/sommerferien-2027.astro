        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In Nordrhein-Westfalen vom Montag, 19. Juli, bis Dienstag, 31. August 2027 (44 Tage)."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Sommerferien 2027 in Bayern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bayern hat vom 2. August bis 13. September 2027 Sommerferien – als letztes Bundesland."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Sommerferien 2027 in Baden-Württemberg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 29. Juli bis 11. September 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Sommerferien 2027 in Niedersachsen und Bremen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Beide Länder vom 8. Juli bis 18. August 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Welches Bundesland hat 2027 zuerst Sommerferien?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hessen, Rheinland-Pfalz und das Saarland starten am 28. Juni 2027 und enden am 6. August 2027."
        }
      },
      {
        "@type": "Question",
        "name": "Wann sind die Sommerferien 2027 in Berlin und Brandenburg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vom 1. Juli bis 14. August 2027. Hamburg ebenfalls ab 1. Juli, aber nur bis 11. August."
        }
      }
    ]
  })} />
</Layout>
