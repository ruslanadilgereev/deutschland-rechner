---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';

const title = "Sommerferien 2027: alle Bundesländer – NRW, Bayern, BW, Niedersachsen";
const description = "Sommerferien 2027 aller 16 Bundesländer nach KMK-Beschluss: Hessen, Rheinland-Pfalz, Saarland ab 28. Juni, NRW 19. Juli–31. August, Niedersachsen 8. Juli–18. August, Baden-Württemberg 29. Juli–11. September, Bayern 2. August–13. September 2027.";
const keywords = "Sommerferien 2027, Sommerferien 2027 NRW, Sommerferien 2027 Bayern, Sommerferien 2027 Baden-Württemberg, Sommerferien 2027 Niedersachsen, Sommerferien 2027 Hessen, Sommerferien 2027 Berlin, Ferien 2027, Sommerferien 2027 Deutschland";
---

<Layout noTitleSuffix title={title} description={description} keywords={keywords}>
  <BreadcrumbSchema items={[{ name: "Sommerferien 2027", url: "/sommerferien-2027" }]} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-2xl p-6 mb-6">
      <h1 class="text-2xl font-bold">Sommerferien 2027: alle Termine je Bundesland</h1>
      <p class="text-white/85 text-sm mt-1">Vom 28. Juni (Hessen, RLP, Saarland) bis 13. September (Bayern) – amtliche KMK-Termine</p>
    </div>

    <p class="text-gray-700 mb-6">
      Die <strong>Sommerferien 2027</strong> beginnen am <strong>28. Juni in Hessen, Rheinland-Pfalz und dem Saarland</strong> und
      enden am <strong>13. September in Bayern</strong>. Nordrhein-Westfalen ist vom 19. Juli bis 31. August frei, Niedersachsen
      vom 8. Juli bis 18. August, Baden-Württemberg vom 29. Juli bis 11. September. Die Termine stammen aus der langfristigen
      Sommerferienregelung der Kultusministerkonferenz (Beschluss vom 09.12.2021 für 2025–2030) und sind amtlich.
    </p>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Sommerferien 2027 aller Bundesländer (nach Beginn sortiert)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-gray-500 border-b"><th class="py-2 pr-4">Bundesland</th><th class="py-2 pr-4">Sommerferien 2027</th><th class="py-2 pr-4">Dauer</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hessen</td><td class="py-2 whitespace-nowrap pr-4">Mo 28.06.2027 – Fr 06.08.2027</td><td class="py-2">40 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Rheinland-Pfalz</td><td class="py-2 whitespace-nowrap pr-4">Mo 28.06.2027 – Fr 06.08.2027</td><td class="py-2">40 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Saarland</td><td class="py-2 whitespace-nowrap pr-4">Mo 28.06.2027 – Fr 06.08.2027</td><td class="py-2">40 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Berlin</td><td class="py-2 whitespace-nowrap pr-4">Do 01.07.2027 – Sa 14.08.2027</td><td class="py-2">45 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Brandenburg</td><td class="py-2 whitespace-nowrap pr-4">Do 01.07.2027 – Sa 14.08.2027</td><td class="py-2">45 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Hamburg</td><td class="py-2 whitespace-nowrap pr-4">Do 01.07.2027 – Mi 11.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Schleswig-Holstein</td><td class="py-2 whitespace-nowrap pr-4">Sa 03.07.2027 – Sa 14.08.2027</td><td class="py-2">43 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Mecklenburg-Vorpommern</td><td class="py-2 whitespace-nowrap pr-4">Mo 05.07.2027 – Sa 14.08.2027</td><td class="py-2">41 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bremen</td><td class="py-2 whitespace-nowrap pr-4">Do 08.07.2027 – Mi 18.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Niedersachsen</td><td class="py-2 whitespace-nowrap pr-4">Do 08.07.2027 – Mi 18.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen</td><td class="py-2 whitespace-nowrap pr-4">Sa 10.07.2027 – Fr 20.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Sachsen-Anhalt</td><td class="py-2 whitespace-nowrap pr-4">Sa 10.07.2027 – Fr 20.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Thüringen</td><td class="py-2 whitespace-nowrap pr-4">Sa 10.07.2027 – Fr 20.08.2027</td><td class="py-2">42 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Nordrhein-Westfalen</td><td class="py-2 whitespace-nowrap pr-4">Mo 19.07.2027 – Di 31.08.2027</td><td class="py-2">44 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Baden-Württemberg</td><td class="py-2 whitespace-nowrap pr-4">Do 29.07.2027 – Sa 11.09.2027</td><td class="py-2">45 Tage</td></tr>
              <tr class="text-gray-700"><td class="py-2 font-medium whitespace-nowrap pr-4">Bayern</td><td class="py-2 whitespace-nowrap pr-4">Mo 02.08.2027 – Mo 13.09.2027</td><td class="py-2">43 Tage</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Erster und letzter Ferientag; Samstage sind je nach Land eingeschlossen. Sonderregelungen gelten in Schleswig-Holstein für die Inseln Sylt, Föhr, Amrum, Helgoland und die Halligen.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Rollierendes System: Warum NRW 2027 spät startet</h2>
      <p class="text-sm text-gray-700 mb-2">Die KMK verteilt die Sommerferien auf fünf Ländergruppen, die von Jahr zu Jahr rotieren, damit sich der Reiseverkehr über rund 90 Tage verteilt. Bayern und Baden-Württemberg sind dauerhaft die letzten (Ende Juli bis Mitte September). 2027 eröffnen Hessen, Rheinland-Pfalz und das Saarland; NRW liegt mit dem 19. Juli in der Mitte, 2026 begann NRW noch am 20. Juli, 2028 startet es bereits am 10. Juli.</p>
      <p class="text-sm text-gray-700">Der gesamte Zeitraum 2027 umfasst 78 Kalendertage (28. Juni bis 13. September). Mindestens eine Bundesland-Familie ist an jedem dieser Tage im Urlaub.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Urlaub in den Sommerferien 2027 planen</h2>
      <p class="text-sm text-gray-700 mb-2">Im Sommer 2027 gibt es keine bundesweiten Feiertage – Brückentage entfallen. Der Tag der Deutschen Einheit fällt auf Sonntag, 3. Oktober. Sechs Wochen Ferien entsprechen 30 Urlaubstagen bei einer 5-Tage-Woche; wie viele Tage Ihnen zustehen, zeigt der <a href="/urlaubstage-rechner" class="text-blue-600 hover:underline">Urlaubstage-Rechner</a>, die Arbeitstage je Monat der <a href="/arbeitstage-rechner" class="text-blue-600 hover:underline">Arbeitstage-Rechner</a>.</p>
      <p class="text-sm text-gray-700">Die übrigen Ferien 2027: <a href="/osterferien-2027" class="text-blue-600 hover:underline">Osterferien</a> · <a href="/pfingstferien-2027" class="text-blue-600 hover:underline">Pfingstferien</a> · <a href="/herbstferien-2027" class="text-blue-600 hover:underline">Herbstferien</a> · <a href="/weihnachtsferien-2027" class="text-blue-600 hover:underline">Weihnachtsferien</a> · <a href="/winterferien-2027" class="text-blue-600 hover:underline">Winterferien</a>.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600 space-y-2">
      <p>🗓️ <strong>Zuletzt aktualisiert am 13. September 2026</strong></p>
      <p><strong>Grundlage:</strong> Langfristige Sommerferienregelung 2025–2030 der Kultusministerkonferenz (Beschluss vom 09.12.2021), KMK-Ferienkalender 2026/27 (Stand 09.10.2025).</p>
      <p><strong>Berücksichtigt:</strong> Erster und letzter Ferientag aller 16 Länder, Dauer in Kalendertagen, Reihenfolge des rollierenden Systems.</p>
      <p><strong>Nicht berücksichtigt:</strong> Bewegliche Ferientage, Inselregelungen in Schleswig-Holstein, kurzfristige Änderungen durch die Kultusministerien.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">❓ Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Sommerferien 2027 in NRW?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">In Nordrhein-Westfalen vom <strong>Montag, 19. Juli, bis Dienstag, 31. August 2027</strong> (44 Tage).</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Sommerferien 2027 in Bayern?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Bayern hat vom <strong>2. August bis 13. September 2027</strong> Sommerferien – als letztes Bundesland.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Sommerferien 2027 in Baden-Württemberg?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom <strong>29. Juli bis 11. September 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Sommerferien 2027 in Niedersachsen und Bremen?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Beide Länder vom <strong>8. Juli bis 18. August 2027</strong>.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Welches Bundesland hat 2027 zuerst Sommerferien?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Hessen, Rheinland-Pfalz und das Saarland starten am 28. Juni 2027 und enden am 6. August 2027.</div>
        </details>
        <details class="border border-gray-200 rounded-lg">
          <summary class="p-4 cursor-pointer font-medium text-gray-800 hover:bg-gray-50">Wann sind die Sommerferien 2027 in Berlin und Brandenburg?</summary>
          <div class="px-4 pb-4 text-sm text-gray-600">Vom 1. Juli bis 14. August 2027. Hamburg ebenfalls ab 1. Juli, aber nur bis 11. August.</div>
        </details>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Weitere Termine und Rechner für 2027</h2>
      <div class="grid sm:grid-cols-2 gap-2 text-sm">
        <a href="/kalender-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">📅 Kalender 2027 mit Feiertagen &amp; KW</a>
        <a href="/feiertage-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🎌 Alle Feiertage 2027 je Bundesland</a>
        <a href="/schulferien-2027" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏫 Schulferien 2027 (alle 16 Länder)</a>
        <a href="/brueckentage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🧮 Brückentage-Rechner 2027</a>
        <a href="/arbeitstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">💼 Arbeitstage 2027 je Bundesland</a>
        <a href="/urlaubstage-rechner" class="block p-3 rounded-lg bg-gray-50 hover:bg-gray-100 text-blue-700">🏖️ Urlaubstage-Rechner</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
